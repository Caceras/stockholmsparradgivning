---
import { Image } from 'astro:assets';
import type { Member } from '../data/site';
import beny from '../assets/team/beny.webp';
import pandora from '../assets/team/pandora.webp';
import lilian from '../assets/team/lilian.webp';
const photos = { beny, pandora, lilian } as const;
interface Props { m: Member; compact?: boolean }
const { m, compact = false } = Astro.props;
---
<article class="member card">
  <Image src={photos[m.slug as keyof typeof photos]} alt={`Porträtt av ${m.name}`} width={120} height={120} densities={[1, 2]} class="avatar" />
  <h3>{m.name}</h3>
  <p class="role">{m.title}</p>
  {!compact && (
    <ul class="creds">{m.credentials.filter((c) => c !== 'Leg. psykoterapeut').map((c) => <li>{c}</li>)}</ul>
  )}
  <dl>
    <div><dt>Telefon</dt><dd><a href={`tel:${m.phoneHref}`}>{m.phone}</a></dd></div>
    <div><dt>E-post</dt><dd><a href={`mailto:${m.email}`}>{m.email}</a></dd></div>
    {m.web && !compact && <div><dt>Webb</dt><dd><a href={m.web.href} rel="noopener">{m.web.label}</a></dd></div>}
  </dl>
</article>
<style>
  .member { display: flex; flex-direction: column; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; margin-bottom: 1.25rem; background: var(--surface); }
  h3 { margin-bottom: 0.15em; }
  .role { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand-deep); font-weight: 600; margin-bottom: 1rem; }
  .creds { list-style: none; padding: 0; margin: 0 0 1.25rem; font-size: 0.93rem; color: var(--muted); }
  .creds li { margin: 0 0 0.2rem; }
  dl { margin: auto 0 0; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 0.93rem; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.2rem 0; }
  dt { color: var(--muted); }
  dd { margin: 0; text-align: right; overflow-wrap: anywhere; }
  dd a { text-decoration: none; }
  dd a:hover { text-decoration: underline; }
</style>
