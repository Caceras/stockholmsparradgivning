---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import { NAV, KOMMUNER } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string, children?: { href: string }[]) =>
  path === href || (children ?? []).some((c) => c.href === path) ||
  (href === '/familjeradgivning/' && KOMMUNER.some((k) => path === `/${k.slug}/`));
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Stockholms Parrådgivning – till startsidan">
      <Image src={logo} alt="Stockholms Parrådgivning" width={176} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>

    <nav class="desk" aria-label="Huvudmeny">
      <ul>
        {NAV.map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={item.href} aria-current={isActive(item.href, item.children) ? 'page' : undefined}>
              {item.label}{item.children && <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>}
            </a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
        <li><a class="btn btn-primary btn-sm" href="/boka-tid/">Boka tid</a></li>
      </ul>
    </nav>

    <details class="mob">
      <summary aria-label="Öppna meny"><span></span><span></span></summary>
      <nav aria-label="Mobilmeny">
        <ul>
          <li><a href="/">Hem</a></li>
          {NAV.map((item) => (
            <li>
              {item.children ? <span class="grp">{item.label}</span> : <a href={item.href}>{item.label}</a>}
              {item.children && (
                <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
              )}
            </li>
          ))}
        </ul>
        <a class="btn btn-primary" href="/boka-tid/">Boka tid <span class="arrow">→</span></a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(250 248 244 / 0.88); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid transparent; transition: border-color .2s; }
  .site-header:hover, .site-header:focus-within { border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 4.75rem; }
  .brand img { width: 150px; height: auto; }
  @media (min-width: 900px) { .brand img { width: 176px; } }

  .desk { display: none; }
  @media (min-width: 980px) { .desk { display: block; } .mob { display: none; } }
  .desk > ul { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .desk li { margin: 0; position: relative; }
  .desk > ul > li > a:not(.btn) { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.6rem 0.85rem; color: var(--ink); text-decoration: none; font-size: 0.95rem; border-radius: 999px; }
  .desk > ul > li > a:not(.btn):hover, .desk a[aria-current='page'] { background: var(--surface); }
  .btn-sm { padding: 0.7rem 1.15rem; margin-left: 0.5rem; }
  .sub { position: absolute; top: calc(100% + 0.4rem); left: 0; min-width: 16rem; list-style: none; margin: 0; padding: 0.5rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .18s, transform .18s, visibility .18s; }
  .sub::before { content: ''; position: absolute; inset: -0.6rem 0 auto; height: 0.6rem; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: 0.55rem 0.75rem; border-radius: 8px; color: var(--ink); text-decoration: none; font-size: 0.93rem; }
  .sub a:hover { background: var(--surface); }

  .mob summary { list-style: none; cursor: pointer; width: 2.75rem; height: 2.75rem; display: grid; place-content: center; gap: 6px; border-radius: 999px; border: 1px solid var(--line); }
  .mob summary::-webkit-details-marker { display: none; }
  .mob summary span { display: block; width: 18px; height: 1.5px; background: var(--ink); transition: transform .2s; }
  .mob[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .mob[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .mob nav { position: absolute; left: 0; right: 0; top: 4.75rem; height: calc(100dvh - 4.75rem); overflow-y: auto; background: var(--paper); padding: 1.5rem var(--gutter) 3rem; border-top: 1px solid var(--line); }
  .mob ul { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .mob > nav > ul > li { border-bottom: 1px solid var(--line); padding: 0.4rem 0; }
  .mob > nav > ul > li > a { font-family: var(--serif); font-size: 1.5rem; color: var(--ink); text-decoration: none; display: block; padding: 0.35rem 0; }
  .mob .grp { display: block; font-family: var(--serif); font-size: 1.5rem; color: var(--ink); padding: 0.35rem 0; }
  .mob ul ul { margin: 0 0 0.5rem; }
  .mob ul ul a { color: var(--muted); text-decoration: none; display: block; padding: 0.3rem 0; }
</style>
