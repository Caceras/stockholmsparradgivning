---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Sidan hittades inte" description="Sidan du letar efter finns inte längre." noindex>
  <PageHead eyebrow="404" title="Sidan hittades inte" lead="Sidan kan ha flyttats. Här är några vägar vidare:">
    <div class="btn-row" style="margin-top:1.5rem">
      <a class="btn btn-primary" href="/">Till startsidan <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="/boka-tid/">Boka tid</a>
      <a class="btn btn-ghost" href="/kommuner/">Kommuner & priser</a>
    </div>
  </PageHead>
</Base>
